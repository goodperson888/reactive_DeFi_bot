# ══════════════════════════════════════════════
# 部署环境：local（本地）/ testnet（测试网）/ mainnet（主网）
# ══════════════════════════════════════════════
APP_ENV=local

# ══════════════════════════════════════════════
# 协议模式：mock（模拟协议）或 prod（真实协议）
# 兼容旧配置：如果仍使用 MODE，会自动映射到 PROTOCOL_MODE
# ══════════════════════════════════════════════
PROTOCOL_MODE=mock
MODE=mock

# ══════════════════════════════════════════════
# 钱包私钥
# local 环境默认可使用 Hardhat 本地账户，不必填写 PRIVATE_KEY
# ══════════════════════════════════════════════
PRIVATE_KEY=your_private_key_here
LOCAL_PRIVATE_KEY=

# ══════════════════════════════════════════════
# RPC 节点
# ══════════════════════════════════════════════
LOCAL_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_KEY
REACTIVE_RPC_URL=https://kopli-rpc.rkt.ink

# mainnet 可选
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ORIGIN_MAINNET_RPC_URL=
DESTINATION_MAINNET_RPC_URL=
ORIGIN_MAINNET_CHAIN_ID=1
DESTINATION_MAINNET_CHAIN_ID=8453
REACTIVE_CHAIN_ID=5318008

# ══════════════════════════════════════════════
# 区块浏览器 API Key（用于合约验证）
# ══════════════════════════════════════════════
ETHERSCAN_API_KEY=your_etherscan_key
BASESCAN_API_KEY=your_basescan_key

# ══════════════════════════════════════════════
# 已部署合约地址（deploy 脚本运行后填入）
# ══════════════════════════════════════════════

# Origin 链（Sepolia）
MOCK_LENDING_ADDRESS=
MOCK_DEX_A_ADDRESS=

# Destination 链（Base Sepolia）
MOCK_DEX_B_ADDRESS=
LIQUIDATION_EXECUTOR_ADDRESS=
ARBITRAGE_EXECUTOR_ADDRESS=

# Reactive Network
RC_CONTROLLER_ADDRESS=
RC_FACTORY_ADDRESS=

# 用户前端流程（Base Sepolia）
USER_VAULT_ADDRESS=

# ══════════════════════════════════════════════
# prod 模式专用（真实 DEX 地址）
# ══════════════════════════════════════════════
SUSHISWAP_ROUTER_BASE_SEPOLIA=
UNISWAP_ROUTER_BASE_SEPOLIA=
