# 环境模式：mock 或 prod
MODE=mock

# 部署脚本优先使用的私钥
# 请替换为你自己的测试网私钥
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# 供部署脚本和跨链演示脚本使用的 RPC
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/

# 供 hardhat.config.js 兼容读取的变量
# 运行 `npx hardhat run ... --network sepolia`、`--network base_sepolia`、
# `--network lasna` 时会用到这组变量
SEPOLIA_URL=https://rpc.sepolia.org
WALLET_KEY1=0xYOUR_PRIVATE_KEY
WALLET_KEY2=

# 浏览器验证 API Key（可选）
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
API_KEY=

# 部署完成后自动回填的合约地址
MOCK_LENDING_ADDRESS=
MOCK_DEX_A_ADDRESS=
MOCK_DEX_B_ADDRESS=
LIQUIDATION_EXECUTOR_ADDRESS=
ARBITRAGE_EXECUTOR_ADDRESS=
RC_CONTROLLER_ADDRESS=

# prod 模式下的 Router 地址
SUSHISWAP_ROUTER_BASE_SEPOLIA=
UNISWAP_ROUTER_BASE_SEPOLIA=
